{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "seed.html"
    ],
    "rewrites": [
      { "source": "/api/meeting", "function": "runMeeting" },
      { "source": "/m/**", "function": "viewMeeting" }
    ]
  }
}
